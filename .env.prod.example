# Production env for `docker compose -f docker-compose.prod.yml`.
# Copy to `.env` (repo root) and fill in real values. NEVER commit `.env`.

# ---- Public edge (Caddy) ---------------------------------------------
# The domain pointed at the VPS (DNS A record -> VPS IP). Caddy issues a
# Let's Encrypt cert for this automatically.
DOMAIN=agentops.example.com
# Basic-auth credentials shown to every browser/curl caller.
AUTH_USER=admin
# bcrypt hash of AUTH_USER's password. Generate with:
#   docker compose -f docker-compose.prod.yml run --rm caddy \
#     caddy hash-password --plaintext 'YOUR_PASSWORD'
# IMPORTANT: escape every `$` as `$$` here — compose otherwise expands
# `$2a`, `$14`, ... as variable refs and corrupts the hash (auth 401s).
# E.g.  AUTH_HASH=$$2a$$14$$<rest>
AUTH_HASH=

# ---- Agent secrets ---------------------------------------------------
# A GitHub personal access token with repo scope.
GITHUB_TOKEN=
# An OpenRouter API key (the free model works but is flaky).
OPENROUTER_API_KEY=

# ---- AgentOps (optional) --------------------------------------------
# Shared by the SDK; the ingestion API ignores it today (no server-side
# auth). Set if you later add a Bearer check on the API.
AGENTOPS_API_KEY=dev

# ---- Database -------------------------------------------------------
POSTGRES_PASSWORD=change_me_in_production

# ---- Agent behaviour -------------------------------------------------
# Read by the agent-service at construction (per run).
#   allow | confirm | deny  (deny blocks every destructive action)
AGENT_DESTRUCTIVE_ACTION_POLICY=allow
# 1 = run the LLM-judge decision-quality eval on each run.
AGENT_DECISION_JUDGE=1
# Cost-aware self-termination budget (tokens). 0 = unlimited.
AGENT_MAX_TOTAL_TOKENS=40000
AGENT_MAX_STEPS=6

# Optional OpenRouter/model overrides (defaults shown).
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_MODEL=openrouter/free
# OPENROUTER_HTTP_REFERER=http://localhost
# OPENROUTER_APP_NAME=github-agent-local
# GITHUB_API_BASE_URL=https://api.github.com