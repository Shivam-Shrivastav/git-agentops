# Public edge for the hosted AgentOps stack.
#
# Env vars (from .env via compose): DOMAIN, AUTH_USER, AUTH_HASH (bcrypt,
# generate with `caddy hash-password --plaintext '...'`).
#
#   /api/*   -> ingestion-api:8000   (strip /api)
#   /agent/* -> agent-service:8001   (strip /agent)
#   /        -> dashboard:5173        (built SPA)
#
# basicauth gates the whole public surface; the agent emits to the
# ingestion API over the internal compose network, not through Caddy, so
# it needs no public auth.

{$DOMAIN} {
	encode gzip

	basic_auth {
		{$AUTH_USER} {$AUTH_HASH}
	}

	@agentApi path /agent/*
	handle @agentApi {
		uri strip_prefix /agent
		reverse_proxy agent-service:8001
	}

	@api path /api/*
	handle @api {
		uri strip_prefix /api
		reverse_proxy ingestion-api:8000
	}

	handle {
		reverse_proxy dashboard:5173
	}
}